rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sirf wo user admin hai jiska UID "admins" collection me document ho
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Website visitors sirf parh sakte hain, likh nahi sakte
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User sirf apna admin document check kar sakta hai; koi likh nahi sakta
    // (admin ko Firebase Console se manually add karte hain)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
